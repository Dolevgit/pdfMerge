<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#1E1F22</Color>
    <Color x:Key="AppSurfaceColor">#2B2D31</Color>
    <Color x:Key="AppSurfaceAltColor">#35383E</Color>
    <Color x:Key="AppMenuColor">#2A2D32</Color>
    <Color x:Key="AppMenuHoverColor">#3A414A</Color>
    <Color x:Key="AppTextColor">#F1F3F5</Color>
    <Color x:Key="AppMutedTextColor">#BAC1CB</Color>
    <Color x:Key="AppBorderColor">#565B66</Color>
    <Color x:Key="AppButtonHoverColor">#3E444D</Color>
    <Color x:Key="AppButtonPressedColor">#48505C</Color>
    <Color x:Key="AppDisabledTextColor">#8A919B</Color>
    <Color x:Key="AppSelectionColor">#315B8A</Color>
    <Color x:Key="AppSuccessColor">#6DD58C</Color>
    <Color x:Key="AppErrorColor">#FF7A7A</Color>
    <Color x:Key="AppLinkColor">#8AB4FF</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="{StaticResource AppSurfaceAltColor}" />
    <SolidColorBrush x:Key="AppMenuBrush" Color="{StaticResource AppMenuColor}" />
    <SolidColorBrush x:Key="AppMenuHoverBrush" Color="{StaticResource AppMenuHoverColor}" />
    <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppTextColor}" />
    <SolidColorBrush x:Key="AppMutedTextBrush" Color="{StaticResource AppMutedTextColor}" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
    <SolidColorBrush x:Key="AppButtonHoverBrush" Color="{StaticResource AppButtonHoverColor}" />
    <SolidColorBrush x:Key="AppButtonPressedBrush" Color="{StaticResource AppButtonPressedColor}" />
    <SolidColorBrush x:Key="AppDisabledTextBrush" Color="{StaticResource AppDisabledTextColor}" />
    <SolidColorBrush x:Key="AppSelectionBrush" Color="{StaticResource AppSelectionColor}" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
    <SolidColorBrush x:Key="AppErrorBrush" Color="{StaticResource AppErrorColor}" />
    <SolidColorBrush x:Key="AppLinkBrush" Color="{StaticResource AppLinkColor}" />

    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource AppTextColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource AppTextColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="{StaticResource AppMenuColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{StaticResource AppTextColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource AppSelectionColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource AppTextColor}" />
</ResourceDictionary>
