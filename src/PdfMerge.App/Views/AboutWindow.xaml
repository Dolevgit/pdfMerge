<Window x:Class="PdfMerge.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="450"
        Height="250"
        MinWidth="450"
        MinHeight="250"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#666666" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D1D5DB" />

        <Style x:Key="DialogButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="186" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Width="186"
                   Height="186"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Stretch="Uniform"
                   Source="/Assets/pdfmerge-logo.png" />

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Top"
                        Margin="0,10,0,0">
                <TextBlock x:Name="AppNameTextBlock"
                           FontSize="20"
                           FontWeight="SemiBold" />

                <TextBlock x:Name="VersionInfoTextBlock"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="LicenseInfoTextBlock"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />

                <TextBlock>
                    <Hyperlink Click="AuthorGitHubLink_OnClick">@Dolevgit</Hyperlink>
                </TextBlock>

                <TextBlock>
                    <Hyperlink x:Name="ProjectGitHubLink"
                               Click="ProjectGitHubLink_OnClick" />
                </TextBlock>

                <Border Margin="0,14,0,0"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Width="18"
                               Height="18"
                               Margin="0,0,8,0"
                               Source="/Assets/codex-logo-small.png" />
                        <TextBlock x:Name="BuiltWithCodexTextBlock"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button x:Name="OkButton"
                    Grid.Column="2"
                    Style="{StaticResource DialogButtonStyle}"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="CloseButton_OnClick" />
        </Grid>
    </Grid>
</Window>
