<Window x:Class="PdfMerge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:settings="clr-namespace:PdfMerge.Application.Settings;assembly=PdfMerge.Application"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Icon="pack://application:,,,/PdfMerge.App;component/Assets/icon.ico"
        Width="1000"
        Height="680"
        MinWidth="800"
        MinHeight="520"
        FlowDirection="{Binding FlowDirection}"
        AllowDrop="True"
        PreviewDragOver="OnPreviewDragOver"
        Drop="OnDrop">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddPdfsCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="CommandButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="IconTextBlockStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MessageHostStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#E8F4E8" />
            <Setter Property="BorderBrush" Value="#6FA36F" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageKind}" Value="{x:Static settings:UserMessageKind.Error}">
                    <Setter Property="Background" Value="#FCEBEC" />
                    <Setter Property="BorderBrush" Value="#C94C4C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding MessageKind}" Value="{x:Static settings:UserMessageKind.Success}">
                    <Setter Property="Background" Value="#E8F4E8" />
                    <Setter Property="BorderBrush" Value="#6FA36F" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{Binding FileMenuText}">
                <MenuItem Header="{Binding AddPdfsText}" Command="{Binding AddPdfsCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="{Binding LanguageMenuText}">
                    <MenuItem Header="{Binding EnglishLanguageText}"
                              Command="{Binding SetEnglishLanguageCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsEnglishSelected, Mode=OneWay}" />
                    <MenuItem Header="{Binding HebrewLanguageText}"
                              Command="{Binding SetHebrewLanguageCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsHebrewSelected, Mode=OneWay}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{Binding ExitText}" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="{Binding EditMenuText}">
                <MenuItem Header="{Binding MoveUpText}" Command="{Binding MoveUpCommand}" />
                <MenuItem Header="{Binding MoveDownText}" Command="{Binding MoveDownCommand}" />
                <MenuItem Header="{Binding RemoveText}" Command="{Binding RemoveCommand}" InputGestureText="Del" />
                <Separator />
                <MenuItem Header="{Binding SelectAllText}" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A" />
            </MenuItem>
            <MenuItem Header="{Binding HelpMenuText}">
                <MenuItem Header="{Binding OpenGitHubProjectText}" Command="{Binding OpenGitHubProjectCommand}" />
                <MenuItem Header="{Binding AboutText}" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}" />
        </StatusBar>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ToolBarTray Grid.Row="0" Margin="0,0,0,12">
                <ToolBar>
                    <Button Style="{StaticResource CommandButtonStyle}" Command="{Binding AddPdfsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconTextBlockStyle}" Text="&#xE710;" />
                            <TextBlock Text="{Binding AddPdfsText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButtonStyle}" Command="{Binding MoveUpCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconTextBlockStyle}" Text="&#xE74A;" />
                            <TextBlock Text="{Binding MoveUpText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButtonStyle}" Command="{Binding MoveDownCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconTextBlockStyle}" Text="&#xE74B;" />
                            <TextBlock Text="{Binding MoveDownText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButtonStyle}" Command="{Binding RemoveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconTextBlockStyle}" Text="&#xE738;" />
                            <TextBlock Text="{Binding RemoveText}" />
                        </StackPanel>
                    </Button>
                    <Separator />
                    <Button Style="{StaticResource CommandButtonStyle}" Command="{Binding MergeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconTextBlockStyle}" Text="&#xE74E;" />
                            <TextBlock Text="{Binding MergeText}" />
                        </StackPanel>
                    </Button>
                </ToolBar>
            </ToolBarTray>

            <Border Grid.Row="1"
                    Style="{StaticResource MessageHostStyle}"
                    Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Padding="10"
                    Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Command="{Binding DismissMessageCommand}"
                            MinHeight="24"
                            Padding="8,2"
                            ToolTip="{Binding DismissText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconTextBlockStyle}" Text="&#xE711;" />
                            <TextBlock Text="{Binding DismissText}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding MessageText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding SelectedFilesText}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <ListView x:Name="SelectedFilesListView"
                          Grid.Row="1"
                          ItemsSource="{Binding SelectedFiles}"
                          SelectionMode="Extended"
                          SelectionChanged="OnSelectedFilesSelectionChanged"
                          KeyboardNavigation.TabNavigation="Continue">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="FileNameColumn" DisplayMemberBinding="{Binding FileName}" Width="240" />
                            <GridViewColumn x:Name="FullPathColumn" DisplayMemberBinding="{Binding FullPath}" Width="640" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
